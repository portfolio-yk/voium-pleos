<?xml version="1.0" encoding="utf-8"?>
<!-- Figma C2 "듣는 중" chip: 초록 12% 배경 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#14131417">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/voium_listening_bg" />
            <!-- 테두리 있는 chip과 높이를 맞추려고 같은 두께의 투명 테두리를 둡니다. -->
            <stroke android:width="2dp" android:color="@android:color/transparent" />
        </shape>
    </item>
</ripple>
