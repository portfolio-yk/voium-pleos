<?xml version="1.0" encoding="utf-8"?>
<!-- 설정 왼쪽 메뉴: 선택되면 basic/100, 아니면 투명 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <ripple android:color="#14131417">
            <item><shape><corners android:radius="20dp" /><solid android:color="@color/voium_basic100" /></shape></item>
        </ripple>
    </item>
    <item>
        <ripple android:color="#14131417">
            <item android:id="@android:id/mask"><shape><corners android:radius="20dp" /><solid android:color="#FFFFFFFF" /></shape></item>
        </ripple>
    </item>
</selector>
