<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상 백업·기기 이전 규칙. 목소리 식별값(개인 정보)은 옮기지 않습니다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="voice_profiles.json" />
        <exclude domain="file" path="conversations.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="voice_profiles.json" />
        <exclude domain="file" path="conversations.json" />
    </device-transfer>
</data-extraction-rules>
