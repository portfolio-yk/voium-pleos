<?xml version="1.0" encoding="utf-8"?>
<!--
  온보딩 (Figma 155:2103 소개, 155:5151 마이크, 155:8202 앰비언트 라이트, 216:4120 권한 팝업).
  어두운 남색 바탕에 흐린 빛과 입자 링, 가운데 문구, 아래 버튼과 쪽 표시.
  세 쪽은 같은 뷰를 쓰고 글자·버튼만 바꿉니다(OnboardingActivity).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding">

    <com.example.pleos.GlowView
        android:id="@+id/onboarding_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.pleos.VoiceOrbView
        android:id="@+id/onboarding_orb"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp" />

    <LinearLayout
        android:id="@+id/onboarding_copy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="390dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/onboarding_label"
            style="@style/Voium.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8EA6FF"
            android:textFontWeight="700"
            android:textSize="30sp"
            tools:text="1 / 2  마이크" />

        <TextView
            android:id="@+id/onboarding_title"
            style="@style/Voium.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:lineHeight="80sp"
            android:textColor="@android:color/white"
            android:textFontWeight="800"
            android:textSize="64sp"
            tools:text="차량에서 오가는\n따듯한 말소리를 자막으로" />

        <TextView
            android:id="@+id/onboarding_desc"
            style="@style/Voium.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineHeight="42sp"
            android:textColor="#FFAEB7D0"
            android:textFontWeight="500"
            android:textSize="30sp"
            tools:text="자막을 켜 둔 동안만 듣고, 원본 음성은 저장하지 않습니다." />

        <LinearLayout
            android:id="@+id/onboarding_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/onboarding_secondary"
                style="@style/Voium.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_onboarding_secondary"
                android:paddingHorizontal="44dp"
                android:paddingVertical="24dp"
                android:textColor="@android:color/white"
                android:textFontWeight="700"
                android:textSize="32sp"
                tools:text="나중에" />

            <TextView
                android:id="@+id/onboarding_primary"
                style="@style/Voium.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_onboarding_primary"
                android:paddingHorizontal="64dp"
                android:paddingVertical="24dp"
                android:textColor="#FF0A0F1E"
                android:textFontWeight="700"
                android:textSize="32sp"
                tools:text="마이크 허용하고 계속" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/onboarding_pager"
            android:layout_width="wrap_content"
            android:layout_height="10dp"
            android:layout_marginTop="40dp"
            android:importantForAccessibility="no"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/onboarding_note"
            style="@style/Voium.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/onboarding_mic_note"
            android:textColor="#FF7F89A6"
            android:textFontWeight="500"
            android:textSize="24sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
