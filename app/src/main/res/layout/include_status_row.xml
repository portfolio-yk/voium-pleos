<?xml version="1.0" encoding="utf-8"?>
<!--
  자막 화면 위쪽의 상단 바 (Figma status_row 243:4249, 261:4281). x=120 y=48 폭 1460.
  왼쪽 state: 상태 점 · 상태 글자(듣는 중 초록 / 대기 회색 / 오류 빨강) · "· 탑승 3명"
  오른쪽 tools: 도움말 · 설정(배경 없는 72dp 원형 버튼) · 16dp 띄우고 대화 종료(진한 알약, 듣는 중·오류일 때만)
  모양은 StatusRow가 상태에 맞춰 바꿉니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/status_row"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginStart="120dp"
    android:layout_marginTop="48dp"
    android:layout_marginEnd="120dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- state: 길게 누르면 확정 자막만 보기(MainActivity) -->
    <LinearLayout
        android:id="@+id/status_button"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/status_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_status_dot_listening" />

        <TextView
            android:id="@+id/status_label"
            style="@style/Voium.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/voium_listening_text"
            android:textFontWeight="800"
            android:textSize="30sp"
            tools:text="듣는 중" />

        <TextView
            android:id="@+id/passengers_label"
            style="@style/Voium.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:importantForAccessibility="no"
            android:textColor="@color/voium_hint"
            android:textFontWeight="700"
            android:textSize="28sp"
            tools:text="· 탑승 3명" />
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- btn_help: 원 + 가운데 "?" -->
    <FrameLayout
        android:id="@+id/help_button"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_icon_button"
        android:clickable="true"
        android:contentDescription="@string/help"
        android:focusable="true">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_help_ring" />

            <TextView
                style="@style/Voium.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="\?"
                android:textColor="@color/voium_idle_text"
                android:textFontWeight="700"
                android:textSize="18sp" />
        </FrameLayout>
    </FrameLayout>

    <!-- btn_settings -->
    <FrameLayout
        android:id="@+id/settings_button"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_icon_button"
        android:clickable="true"
        android:contentDescription="@string/settings_title"
        android:focusable="true">

        <ImageView
            android:id="@+id/settings_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_settings_cog" />
    </FrameLayout>

    <!-- btn_end: 듣는 중·오류일 때만 -->
    <LinearLayout
        android:id="@+id/end_button"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_marginStart="40dp"
        android:background="@drawable/bg_end_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_stop_white" />

        <TextView
            android:id="@+id/end_label"
            style="@style/Voium.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/end_conversation"
            android:textColor="@android:color/white"
            android:textFontWeight="800"
            android:textSize="30sp" />
    </LinearLayout>
</LinearLayout>
