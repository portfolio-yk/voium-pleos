<?xml version="1.0" encoding="utf-8"?>
<!-- 프로필 카드 (Figma profile_card): 506×128, 아바타 72 · 이름 · 오른쪽 화살표(주행 중에는 숨김) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="128dp"
    android:layout_weight="1"
    android:background="@drawable/bg_card_28"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="28dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/card_avatar"
        style="@style/Voium.Text.TitleMediumStrong"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="#FFFFFFFF"
        tools:text="엄" />

    <TextView
        android:id="@+id/card_name"
        style="@style/Voium.Text.TitleSmallStrong"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        tools:text="엄마" />

    <ImageView
        android:id="@+id/card_chevron"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right" />
</LinearLayout>
