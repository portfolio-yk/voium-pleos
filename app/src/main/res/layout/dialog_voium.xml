<?xml version="1.0" encoding="utf-8"?>
<!--
  확인 대화상자 (Figma 89:1301 dialog): 760dp, 모서리 32dp, 왼쪽 정렬 제목 36sp · 설명 30sp,
  아래에 80dp 버튼 두 개(왼쪽 취소, 오른쪽 주 동작).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_32"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="48dp"
    android:paddingEnd="48dp"
    android:paddingBottom="40dp">

    <TextView
        android:id="@+id/dialog_title"
        style="@style/Voium.Text.TitleMediumStrong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        tools:text="엄마 프로필을 삭제할까요?" />

    <TextView
        android:id="@+id/dialog_description"
        style="@style/Voium.Text.BodyLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/voium_text_secondary"
        android:visibility="gone"
        tools:text="이름, 색, 목소리 특징이 바로 삭제되며 되돌릴 수 없습니다."
        tools:visibility="visible" />

    <FrameLayout
        android:id="@+id/dialog_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialog_cancel"
            style="@style/Voium.Text.BodyLargeStrong"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_basic_medium"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cancel" />

        <TextView
            android:id="@+id/dialog_confirm"
            style="@style/Voium.Text.BodyLargeStrong"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_filled_medium"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            tools:text="삭제" />
    </LinearLayout>
</LinearLayout>
