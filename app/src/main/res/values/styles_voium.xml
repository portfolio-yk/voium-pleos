<?xml version="1.0" encoding="utf-8"?>
<!--
  VOIUM C2 글자 스타일(style=로 씁니다. lineHeight 등은 textAppearance로는 적용되지 않습니다). Figma의 Asta Sans 텍스트 스타일과 같은 크기·줄 높이·굵기입니다.
  Asta Sans는 굵기는 textFontWeight로 고릅니다(font/asta_sans.xml에 굵기별로 등록). textStyle bold를 쓰면 가짜 굵기가 됩니다.
-->
<resources>
    <style name="Voium.Text" parent="">
        <item name="android:fontFamily">@font/asta_sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/voium_text_primary</item>
    </style>

    <!-- Body/Small/Strong: 26sp / 34sp, 700 -->
    <style name="Voium.Text.BodySmallStrong">
        <item name="android:textSize">26sp</item>
        <item name="android:lineHeight">34sp</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <!-- Body/Medium/Strong: 28sp / 36sp, 700 -->
    <style name="Voium.Text.BodyMediumStrong">
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight">36sp</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <!-- Title/Large/Strong: 40sp / 52sp, 700 -->
    <style name="Voium.Text.TitleLargeStrong">
        <item name="android:textSize">40sp</item>
        <item name="android:lineHeight">52sp</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <!-- Body/Large/Normal: 30sp / 38sp, 400 (IVI 팝업 설명) -->
    <style name="Voium.Text.BodyLarge">
        <item name="android:textSize">30sp</item>
        <item name="android:lineHeight">38sp</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <!-- Title/Small/Strong: 32sp / 40sp, 700 (IVI 버튼 글자) -->
    <style name="Voium.Text.TitleSmallStrong">
        <item name="android:textSize">32sp</item>
        <item name="android:lineHeight">40sp</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <!-- Title/Large/Extra_Strong: 40sp / 52sp, 800 (화면·팝업 제목) -->
    <style name="Voium.Text.TitleLargeExtraStrong">
        <item name="android:textSize">40sp</item>
        <item name="android:lineHeight">52sp</item>
        <item name="android:textFontWeight">800</item>
    </style>

    <!-- Body/Large/Strong: 30sp / 38sp, 700 (설정 메뉴, 버튼) -->
    <style name="Voium.Text.BodyLargeStrong">
        <item name="android:textSize">30sp</item>
        <item name="android:lineHeight">38sp</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <!-- Title/Medium/Strong: 36sp / 44sp, 700 (빈 상태 제목, 대화상자 제목) -->
    <style name="Voium.Text.TitleMediumStrong">
        <item name="android:textSize">36sp</item>
        <item name="android:lineHeight">44sp</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <!-- Title/Large/Strong 40/52 700은 Voium.Text.TitleLargeStrong -->

    <!-- Headline/Small/Extra_Strong: 48sp / 64sp, 800 (목소리 등록 안내) -->
    <style name="Voium.Text.HeadlineSmallExtraStrong">
        <item name="android:textSize">48sp</item>
        <item name="android:lineHeight">64sp</item>
        <item name="android:textFontWeight">800</item>
    </style>

    <!-- 지난 자막 한 줄: 32sp / 40sp, 500 -->
    <style name="Voium.Text.CaptionLine">
        <item name="android:textSize">32sp</item>
        <item name="android:lineHeight">40sp</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <!-- 지금 자막 (Figma 120:3715): 96sp, 줄 높이 1.25배, 800 -->
    <style name="Voium.Text.CaptionCurrent">
        <item name="android:textSize">96sp</item>
        <item name="android:lineHeight">120sp</item>
        <item name="android:textFontWeight">800</item>
    </style>

    <!-- 목소리 등록에서 읽을 문장: 72sp / 92sp, 800 -->
    <style name="Voium.Text.Karaoke">
        <item name="android:textSize">72sp</item>
        <item name="android:lineHeight">92sp</item>
        <item name="android:textFontWeight">800</item>
    </style>

    <!-- Headline/Medium/Extra_Strong: 56sp / 72sp, 800 -->
    <style name="Voium.Text.HeadlineExtraStrong">
        <item name="android:textSize">56sp</item>
        <item name="android:lineHeight">72sp</item>
        <item name="android:textFontWeight">800</item>
    </style>

    <!-- 대화 제안·일시 정지 문구 (Figma 120:5249): 96sp, 줄 높이 1.25배, 800 -->
    <style name="Voium.Text.DisplayExtraStrong">
        <item name="android:textSize">96sp</item>
        <item name="android:lineHeight">120sp</item>
        <item name="android:textFontWeight">800</item>
    </style>
</resources>
