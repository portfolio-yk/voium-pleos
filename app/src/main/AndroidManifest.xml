<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 네트워크가 돌아오면 바로 다시 연결 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- 빠른 답장을 차량 스피커로 읽어 줍니다 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- Pleos 차량 정보 (모두 normal 권한) -->
    <!-- 좌석에 앉은 사람 수: "탑승 N명" -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- 실내 조명(앰비언트 라이트) 색: 말하는 사람의 색 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- 조명 색 바꾸기: 문서에는 CAR_LIGHTS라고 되어 있지만 SDK 2.3.2 구현은 CONTROL_CAR_LIGHTS를 확인합니다. -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <!-- 기어(P): 프로필 편집·목소리 등록은 정차 중에만 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 와이퍼 작동 여부(비): 대화 제안의 날씨 카드 -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <!-- 목적지·경유지와 남은 시간: 대화 제안 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- 대화 기록 AI 요약 (Pleos LLM) -->
    <uses-permission android:name="pleos.car.permission.LLM_SERVICE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pleos">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:theme="@style/Theme.Pleos.Voium">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 자막을 볼 수 있게 합니다(차량 시스템이 주행 중 화면을 막지 않음). -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <!-- 처음 실행할 때 한 번 보여 주는 소개 -->
        <activity
            android:name=".OnboardingActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.Pleos.Voium" />

        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Pleos.Voium.Sheet">
            <!-- 주행 중에도 열리되, 편집·등록·지난 대화 보기는 앱이 직접 막습니다(Figma '주행 중' 화면). -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <activity
            android:name=".VoiceEnrollmentActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Pleos.Voium.Sheet" />

    </application>

</manifest>